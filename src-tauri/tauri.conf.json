{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Buddy",
  "mainBinaryName": "StreamBuddy",
  "version": "../package.json",
  "identifier": "com.jslquintero.streambuddy",
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "stage/app/": "app/"
    },
    "externalBin": ["binaries/node", "binaries/tiktok-bridge"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "installerHooks": "windows/install.nsh"
      }
    }
  }
}
